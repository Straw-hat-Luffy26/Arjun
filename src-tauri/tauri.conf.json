{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARJUN",
  "version": "0.2.0",
  "identifier": "com.arjun.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build --prefix agent-runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARJUN",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src widget: http://widget.localhost; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../agent-runtime/dist/arjun-agent-runtime.mjs",
      "../skills/",
      "../agents/",
      "../sidecars/document_sidecar/",
      "../sidecars/memory_engine_sidecar/",
      "../sidecars/voice_sidecar/"
    ]
  }
}
